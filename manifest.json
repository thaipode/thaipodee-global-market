<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/du7z0r5q9/image/upload/v1726090000/thaipodee-icon.png">
  <title>Thaipodee Market Online V2026</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    body { background: #000; color: #fff; height: 100vh; height: 100dvh; overflow: hidden; }

    .video-container { position: relative; width: 100%; height: 100%; }
    video { width: 100%; height: 100%; object-fit: cover; }

    .right-icons {
      position: absolute;
      right: 12px;
      bottom: 180px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      z-index: 10;
    }
    .icon-group { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .icon { font-size: 28px; cursor: pointer; text-shadow: 0 0 4px rgba(0,0,0,0.5); }
    .icon-text { font-size: 11px; color: #fff; }

    /* ✅ ตัวนี้แหละ — กลมแน่นอน! */
    .music-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      clip-path: circle(50% at center);
      object-fit: cover;
      overflow: hidden;
      border: 2px solid #fff;
    }

    .video-info {
      position: absolute;
      left: 16px;
      bottom: 90px;
      right: 80px;
      z-index: 5;
    }
    .video-title { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
    .video-desc { font-size: 13px; opacity: 0.8; line-height: 1.4; }

    .bottom-nav {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 65px;
      background: rgba(0,0,0,0.8);
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 10;
    }
    .nav-item { text-align: center; cursor: pointer; }
    .nav-icon { font-size: 24px; }
    .nav-text { font-size: 10px; color: #ccc; }
    .nav-center { font-size: 36px; }
  </style>
</head>
<body>

<div class="video-container">
  <video id="mainVideo" src="" loop playsinline></video>

  <div class="video-info">
    <div class="video-title">ชื่อวิดีโอ</div>
    <div class="video-desc">คำอธิบายวิดีโอ</div>
  </div>

  <div class="right-icons">
    <div class="icon-group"><div class="icon">👤</div></div>
    <div class="icon-group"><div class="icon">❤️</div><div class="icon-text">0</div></div>
    <div class="icon-group"><div class="icon">💬</div><div class="icon-text">0</div></div>
    <div class="icon-group"><div class="icon">🔖</div><div class="icon-text">0</div></div>
    <div class="icon-group"><div class="icon">↗️</div><div class="icon-text">17</div></div>
    <div class="icon-group">
      <img class="music-avatar" src="" alt="เสียงต้นฉบับ">
    </div>
  </div>

  <!-- ❌ ลบอันนี้ทิ้ง — ห้ามมี! <img class="small-video-preview"> -->

  <div class="bottom-nav">
    <div class="nav-item"><div class="nav-icon">🏠</div><div class="nav-text">หน้าแรก</div></div>
    <div class="nav-item"><div class="nav-icon">🔍</div><div class="nav-text">ค้นหา</div></div>
    <div class="nav-item"><div class="nav-icon nav-center">➕</div></div>
    <div class="nav-item"><div class="nav-icon">📥</div><div class="nav-text">กล่องข้อความ</div></div>
    <div class="nav-item"><div class="nav-icon">👤</div><div class="nav-text">โปรไฟล์</div></div>
  </div>
</div>

<script>
  const video = document.getElementById('mainVideo');
  document.querySelector('.video-container').addEventListener('click', () => {
    video.paused ? video.play() : video.pause();
  });
</script>

</body>
</html>
